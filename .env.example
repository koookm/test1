# Expert Investment Team - API Keys Configuration
# Copy this file to .env and fill in your API keys

# LLM Providers (at least one required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Data Sources (optional but recommended)
FRED_API_KEY=your_fred_api_key_here          # US macro data (free: https://fred.stlouisfed.org/docs/api/api_key.html)
NEWS_API_KEY=your_news_api_key_here          # News articles (free tier: https://newsapi.org/)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key # Market data (free: https://www.alphavantage.co/)

# Optional: Debug mode
# DEBUG=1
