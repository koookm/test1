# Expert Investment Team - 인증 설정
# 이 파일을 .env로 복사하고 사용할 provider에 맞게 채워주세요.

# ============================================================
# [1안] Anthropic OAuth (기본값, 권장)
# Claude Code / claude.ai 계정으로 자동 인증됩니다.
#
# 방법 A: Claude Code가 설치되어 있으면 ~/.claude/credentials.json에서
#          자동으로 OAuth 토큰을 읽어옵니다 (별도 설정 불필요).
#
# 방법 B: 직접 토큰 지정
# ANTHROPIC_ACCESS_TOKEN=<claude.ai OAuth access token>
#
# 방법 C: API Key fallback (OAuth 토큰 없을 때 자동 사용)
# ANTHROPIC_API_KEY=sk-ant-...
# ============================================================
ANTHROPIC_ACCESS_TOKEN=
ANTHROPIC_API_KEY=

# ============================================================
# [2안] Google Gemini
# 발급: https://aistudio.google.com/app/apikey  (무료 티어 있음)
# 실행: python main.py --provider gemini
# ============================================================
GOOGLE_API_KEY=

# ============================================================
# 기타 Provider
# ============================================================
OPENAI_API_KEY=

# ============================================================
# 데이터 소스 (선택, 없으면 yfinance proxy 사용)
# ============================================================
# FRED API (미국 거시지표, 무료): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# News API (뉴스, 무료티어): https://newsapi.org/
NEWS_API_KEY=

# Alpha Vantage (시장데이터, 무료): https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=

# ============================================================
# 디버그
# ============================================================
# DEBUG=1
